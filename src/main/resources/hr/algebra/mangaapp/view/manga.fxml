<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="hr.algebra.mangaapp.controller.MangaController">

    <top>
        <VBox spacing="8">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Manga / Comics"/>

            <HBox spacing="10">
                <TextField fx:id="searchTitleTextField" promptText="Search by title"/>
                <ComboBox fx:id="searchStatusComboBox" promptText="Status"/>
                <ComboBox fx:id="searchPublisherComboBox" promptText="Publisher"/>

                <Button text="Search" onAction="#handleSearch"/>
                <Button text="Refresh" onAction="#handleRefresh"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="mangaTableView">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                <TableColumn fx:id="titleColumn" text="Title" prefWidth="180"/>
                <TableColumn fx:id="releaseYearColumn" text="Year" prefWidth="80"/>
                <TableColumn fx:id="volumesColumn" text="Volumes" prefWidth="80"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="110"/>
                <TableColumn fx:id="publisherColumn" text="Publisher" prefWidth="150"/>
                <TableColumn fx:id="authorsColumn" text="Authors" prefWidth="220"/>
                <TableColumn fx:id="genresColumn" text="Genres" prefWidth="220"/>
                <TableColumn fx:id="charactersColumn" text="Characters" prefWidth="260"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="8">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <TabPane tabClosingPolicy="UNAVAILABLE" prefHeight="230">
                <tabs>

                    <Tab text="Main Info">
                        <HBox spacing="20">
                            <padding>
                                <Insets top="10" right="10" bottom="10" left="10"/>
                            </padding>

                            <VBox spacing="10" HBox.hgrow="ALWAYS">
                                <GridPane hgap="10" vgap="8">
                                    <Label text="Title:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                    <TextField fx:id="titleTextField"
                                               promptText="Title"
                                               GridPane.rowIndex="0"
                                               GridPane.columnIndex="1"/>

                                    <Label text="Release year:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                    <TextField fx:id="releaseYearTextField"
                                               promptText="e.g. 1998"
                                               GridPane.rowIndex="0"
                                               GridPane.columnIndex="3"/>

                                    <Label text="Volumes:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                    <TextField fx:id="volumesTextField"
                                               promptText="e.g. 42"
                                               GridPane.rowIndex="1"
                                               GridPane.columnIndex="1"/>

                                    <Label text="Status:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                    <ComboBox fx:id="statusComboBox"
                                              promptText="Status"
                                              GridPane.rowIndex="1"
                                              GridPane.columnIndex="3"/>

                                    <Label text="Publisher:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                    <ComboBox fx:id="publisherComboBox"
                                              promptText="Publisher"
                                              GridPane.rowIndex="2"
                                              GridPane.columnIndex="1"/>

                                    <Label text="Image path:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                                    <TextField fx:id="imagePathTextField"
                                               promptText="assets/covers/image.jpg"
                                               GridPane.rowIndex="2"
                                               GridPane.columnIndex="3"
                                                prefWidth="200"/>
                                </GridPane>

                                <TextArea fx:id="descriptionTextArea"
                                          promptText="Synopsis / description"
                                          prefRowCount="3"
                                          wrapText="true"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Cover preview"/>
                                <StackPane prefWidth="140" prefHeight="200">
                                    <ImageView fx:id="coverImageView"
                                               fitWidth="140"
                                               fitHeight="200"
                                               preserveRatio="true"
                                               smooth="true"/>
                                </StackPane>
                            </VBox>

                        </HBox>
                    </Tab>

                    <Tab text="Relations">
                        <HBox spacing="12">
                            <padding>
                                <Insets top="10" right="10" bottom="10" left="10"/>
                            </padding>

                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Authors"/>
                                <HBox spacing="5">
                                    <ComboBox fx:id="authorComboBox" promptText="Author"/>
                                    <Button text="Add" onAction="#handleAddAuthor"/>
                                </HBox>
                                <ListView fx:id="selectedAuthorsListView" prefHeight="110"/>
                                <Button text="Remove selected author" onAction="#handleRemoveAuthor"/>
                            </VBox>

                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Genres"/>
                                <HBox spacing="5">
                                    <ComboBox fx:id="genreComboBox" promptText="Genre"/>
                                    <Button text="Add" onAction="#handleAddGenre"/>
                                </HBox>
                                <ListView fx:id="selectedGenresListView" prefHeight="110"/>
                                <Button text="Remove selected genre" onAction="#handleRemoveGenre"/>
                            </VBox>

                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Characters"/>

                                <HBox spacing="10">
                                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                                        <Label text="Available characters"/>
                                        <ListView fx:id="availableCharactersListView" prefHeight="110"/>
                                    </VBox>

                                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                                        <Label text="Selected characters"/>
                                        <ListView fx:id="selectedCharactersListView" prefHeight="110"/>
                                    </VBox>
                                </HBox>

                                <HBox spacing="5">
                                    <ComboBox fx:id="characterComboBox" promptText="Character"/>
                                    <Button text="Add" onAction="#handleAddCharacter"/>
                                    <Button text="Remove selected" onAction="#handleRemoveCharacter"/>
                                </HBox>

                                <Label text="Tip: Drag a character from Available characters to Selected characters."/>
                            </VBox>
                        </HBox>
                    </Tab>

                </tabs>
            </TabPane>

            <HBox spacing="10">
                <Button text="Add Manga" onAction="#handleAdd"/>
                <Button text="Update Manga" onAction="#handleUpdate"/>
                <Button text="Delete Manga" onAction="#handleDelete"/>
                <Button text="Clear" onAction="#handleClear"/>
            </HBox>

            <Label fx:id="messageLabel"/>
        </VBox>
    </bottom>

</BorderPane>