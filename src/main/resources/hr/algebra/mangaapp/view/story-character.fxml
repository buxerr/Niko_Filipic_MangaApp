<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="hr.algebra.mangaapp.controller.StoryCharacterController">

    <top>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <TextField fx:id="searchTextField" promptText="Search character"/>
            <ComboBox fx:id="searchRoleComboBox" promptText="Role"/>
            <Button text="Search" onAction="#handleSearch"/>
            <Button text="Refresh" onAction="#handleRefresh"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="characterTableView">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="80"/>
                <TableColumn fx:id="firstNameColumn" text="First name" prefWidth="220"/>
                <TableColumn fx:id="lastNameColumn" text="Last name" prefWidth="220"/>
                <TableColumn fx:id="roleColumn" text="Role" prefWidth="160"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="8">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <TextField fx:id="firstNameTextField" promptText="First name"/>
            <TextField fx:id="lastNameTextField" promptText="Last name"/>
            <ComboBox fx:id="roleComboBox"
                      promptText="Character role"
                      GridPane.rowIndex="1"
                      GridPane.columnIndex="1"/>

            <HBox spacing="10">
                <Button text="Add" onAction="#handleAdd"/>
                <Button text="Update" onAction="#handleUpdate"/>
                <Button text="Delete" onAction="#handleDelete"/>
                <Button text="Clear" onAction="#handleClear"/>
            </HBox>

            <Label fx:id="messageLabel"/>
        </VBox>
    </bottom>

</BorderPane>