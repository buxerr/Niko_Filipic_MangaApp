<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>

<?import javafx.scene.layout.StackPane?>
<BorderPane fx:id="root"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="hr.algebra.mangaapp.controller.MainController">

    <top>
        <MenuBar>
            <Menu text="File">
                <MenuItem text="Logout" onAction="#handleLogout"/>
                <MenuItem text="Exit" onAction="#handleExit"/>
            </Menu>

            <Menu text="Manage">
                <MenuItem text="Manga" onAction="#handleManga"/>
                <MenuItem text="Genres" onAction="#handleGenres"/>
                <MenuItem text="Authors" onAction="#handleAuthors"/>
                <MenuItem text="Publishers" onAction="#handlePublishers"/>
                <MenuItem text="Characters" onAction="#handleCharacters"/>
            </Menu>

            <Menu fx:id="adminMenu" text="Admin">
                <MenuItem text="Clear Data" onAction="#handleClearData"/>
                <MenuItem text="Import Data" onAction="#handleImportData"/>
                <MenuItem text="Backup XML" onAction="#handleBackupXml"/>
            </Menu>
        </MenuBar>
    </top>

    <center>
        <StackPane fx:id="contentPane">
            <Label fx:id="welcomeLabel" text="Welcome to MangaApp"/>
        </StackPane>
    </center>

</BorderPane>